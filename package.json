{
  "name": "@local/bark-notify",
  "version": "1.0.0",
  "private": true,
  "description": "Push Bark notifications to iPhone and Apple Watch when an agent finishes a run or needs approval.",
  "type": "module",
  "main": "plugin.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./plugin.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "plugin.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
